# ============================================================
# VARIABLES DE ENTORNO — BACKEND (NestJS)
# ============================================================
# Copia este archivo como .env y completa los valores.
# NUNCA subas .env a git (ya está en .gitignore).

# ── Base de datos (Supabase PostgreSQL) ──────────────────────
# URL con connection pooler (para consultas normales en producción)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL directa (para migraciones de Prisma — NO usa pooler)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Supabase (para Storage) ───────────────────────────────────
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="tu-anon-key-aqui"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key-aqui"

# ── Storage ───────────────────────────────────────────────────
# Nombre del bucket en Supabase Storage para imágenes de productos
SUPABASE_STORAGE_BUCKET="products"

# ── Autenticación JWT ─────────────────────────────────────────
# Genera un secreto fuerte: openssl rand -base64 64
JWT_SECRET="cambia-esto-por-un-secreto-muy-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# ── Aplicación ────────────────────────────────────────────────
NODE_ENV="development"
PORT=3000
# Origen permitido para CORS (URL del frontend Vue)
CORS_ORIGIN="http://localhost:5173"
